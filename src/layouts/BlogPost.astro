---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import "katex/dist/katex.min.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

const fileName = `${title
  .toLowerCase()
  .replaceAll(":", "")
  .replaceAll(",", "")
  .replaceAll(" ", "-")}.md`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />

    <style>
      :global(body) {
        margin: 0;
        background:
          linear-gradient(rgba(103, 232, 249, 0.035) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(103, 232, 249, 0.035) 1px,
            transparent 1px
          ),
          radial-gradient(
            circle at 18% 8%,
            rgba(34, 211, 238, 0.14),
            transparent 34rem
          ),
          radial-gradient(
            circle at 85% 95%,
            rgba(16, 185, 129, 0.1),
            transparent 34rem
          ),
          #020607;
        background-size:
          48px 48px,
          48px 48px,
          auto,
          auto,
          auto;
        color: #d1fae5;
      }

      main {
        width: 100%;
        box-sizing: border-box;
        padding: 2rem 1.5rem 4rem;
      }

      .article-terminal {
        width: min(1500px, 94vw);
        margin: 0 auto;
        border: 1px solid rgba(103, 232, 249, 0.28);
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(
          180deg,
          rgba(8, 47, 55, 0.92),
          rgba(2, 16, 18, 0.96)
        );
        box-shadow:
          0 0 0 1px rgba(20, 184, 166, 0.08),
          0 30px 110px rgba(0, 0, 0, 0.55),
          0 0 80px rgba(34, 211, 238, 0.08);
      }

      .terminal-bar {
        height: 42px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        padding: 0 1rem;
        background: rgba(1, 9, 12, 0.95);
        border-bottom: 1px solid rgba(103, 232, 249, 0.2);
      }

      .traffic-lights {
        display: flex;
        gap: 0.5rem;
      }

      .traffic-lights span {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        display: block;
      }

      .red {
        background: #fb7185;
      }

      .yellow {
        background: #facc15;
      }

      .green {
        background: #4ade80;
      }

      .terminal-title {
        text-align: center;
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 700;
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      .status {
        color: #86efac;
        font-size: 0.75rem;
        font-weight: 800;
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      .article-body {
        padding: clamp(2rem, 4vw, 4.5rem);
      }

      .command {
        max-width: 1300px;
        color: #86efac;
        font-weight: 800;
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 2rem;
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        color: #67e8f9;
        font-size: 0.9rem;
        margin-bottom: 2.25rem;
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      h1 {
        max-width: 1300px;
        margin: 0 0 1.25rem;
        color: white;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        font-size: clamp(3rem, 4.4vw, 5.4rem);
        line-height: 1.02;
        font-weight: 760;
        letter-spacing: -0.055em;
      }

      .description {
        max-width: 1150px;
        color: #94a3b8;
        font-size: 1.08rem;
        line-height: 1.85;
        margin-bottom: 3.25rem;
      }

      .hero-image img {
        width: 100%;
        border-radius: 12px;
        margin-bottom: 3rem;
      }

      .prose {
        width: 100%;
        max-width: none;
        color: #d1d5db;
        font-size: 1.06rem;
        line-height: 1.95;
      }

      .prose :global(p) {
        max-width: 1050px;
      }

      .prose :global(h2),
      .prose :global(h3),
      .prose :global(h4),
      .prose :global(ul),
      .prose :global(ol),
      .prose :global(blockquote),
      .prose :global(pre),
      .prose :global(table) {
        max-width: 1200px;
      }

      .prose :global(h2) {
        color: #67e8f9;
        margin-top: 4rem;
        margin-bottom: 1rem;
        line-height: 1.18;
        font-size: clamp(1.8rem, 3vw, 2.8rem);
      }

      .prose :global(h3) {
        color: #a5f3fc;
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
      }

      .prose :global(strong) {
        color: white;
      }

      .prose :global(a) {
        color: #67e8f9;
      }

      .prose :global(blockquote) {
        border-left: 3px solid rgba(103, 232, 249, 0.5);
        margin-left: 0;
        padding-left: 1rem;
        color: #94a3b8;
        font-style: italic;
      }

      .prose :global(code) {
        background: rgba(8, 145, 178, 0.15);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
      }

      .prose :global(pre) {
        background: rgba(1, 9, 12, 0.9);
        border: 1px solid rgba(103, 232, 249, 0.15);
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
      }

      .prose :global(.katex-display) {
        max-width: 1200px;
        margin: 1.75rem 0;
        padding: 1.25rem;
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid rgba(103, 232, 249, 0.15);
        border-radius: 8px;
        background: rgba(1, 9, 12, 0.72);
        color: #ecfeff;
      }

      .prose :global(ul),
      .prose :global(ol) {
        padding-left: 1.5rem;
      }

      @media (max-width: 720px) {
        main {
          padding: 1rem 0.75rem 3rem;
        }

        .article-terminal {
          width: 100%;
        }

        .article-body {
          padding: 1.5rem;
        }

        h1 {
          font-size: clamp(2.4rem, 12vw, 3.5rem);
        }

        .terminal-title {
          font-size: 0.7rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <article class="article-terminal">
        <div class="terminal-bar">
          <div class="traffic-lights">
            <span class="red"></span>
            <span class="yellow"></span>
            <span class="green"></span>
          </div>

          <div class="terminal-title">ronnie-ai-blog:~/posts</div>

          <div class="status">published</div>
        </div>

        <div class="article-body">
          <div class="command">$ cat {fileName}</div>

          <div class="meta">
            <span>
              Published:
              <FormattedDate date={pubDate} />
            </span>

            {
              updatedDate && (
                <span>
                  Updated:
                  <FormattedDate date={updatedDate} />
                </span>
              )
            }
          </div>

          <h1>{title}</h1>

          <p class="description">{description}</p>

          {
            heroImage && (
              <div class="hero-image">
                <Image width={1200} height={600} src={heroImage} alt="" />
              </div>
            )
          }

          <div class="prose">
            <slot />
          </div>
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>
