---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";

const SITE_TITLE = "Ronnie's AI Blog";
const SITE_DESCRIPTION =
  "Field notes on AI systems, RAG, agents, semantic search, automation, and engineering.";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Posts | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      :global(body) {
        margin: 0;
        background:
          linear-gradient(rgba(103, 232, 249, 0.035) 1px, transparent 1px),
          linear-gradient(
            90deg,
            rgba(103, 232, 249, 0.035) 1px,
            transparent 1px
          ),
          radial-gradient(
            circle at 18% 8%,
            rgba(34, 211, 238, 0.14),
            transparent 34rem
          ),
          radial-gradient(
            circle at 85% 95%,
            rgba(16, 185, 129, 0.1),
            transparent 34rem
          ),
          #020607;
        background-size:
          48px 48px,
          48px 48px,
          auto,
          auto,
          auto;
        color: #d1fae5;
      }

      main {
        width: 100%;
        box-sizing: border-box;
        padding: 2rem 1.5rem 4rem;
      }

      .terminal {
        width: min(1500px, 94vw);
        margin: 0 auto;
        border: 1px solid rgba(103, 232, 249, 0.28);
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(
          180deg,
          rgba(8, 47, 55, 0.92),
          rgba(2, 16, 18, 0.96)
        );
        box-shadow:
          0 0 0 1px rgba(20, 184, 166, 0.08),
          0 30px 110px rgba(0, 0, 0, 0.55),
          0 0 80px rgba(34, 211, 238, 0.08);
      }

      .terminal-bar {
        height: 42px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        padding: 0 1rem;
        background: rgba(1, 9, 12, 0.95);
        border-bottom: 1px solid rgba(103, 232, 249, 0.2);
      }

      .traffic-lights {
        display: flex;
        gap: 0.5rem;
      }

      .traffic-lights span {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        display: block;
      }

      .red {
        background: #fb7185;
      }

      .yellow {
        background: #facc15;
      }

      .green {
        background: #4ade80;
      }

      .terminal-title {
        text-align: center;
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 700;
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      .status {
        color: #86efac;
        font-size: 0.75rem;
        font-weight: 800;
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      .terminal-body {
        padding: clamp(2rem, 4vw, 4.5rem);
        font-family: "SFMono-Regular", Consolas, Menlo, monospace;
      }

      .command {
        margin: 0 0 1.5rem;
        color: #86efac;
        font-weight: 800;
        font-size: 1rem;
      }

      h1 {
        margin: 0 0 0.75rem;
        color: #f8fafc;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        font-size: clamp(3rem, 4.4vw, 5.4rem);
        line-height: 1.02;
        font-weight: 760;
        letter-spacing: -0.055em;
      }

      .description {
        max-width: 1050px;
        margin: 0 0 2.5rem;
        color: #94a3b8;
        font-size: 1rem;
        line-height: 1.8;
      }

      .file-list {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-top: 1.5rem;
        border-top: 1px solid rgba(103, 232, 249, 0.16);
        padding-top: 1.5rem;
      }

      .file-row {
        display: grid;
        grid-template-columns: 11rem 8rem 1fr;
        gap: 1rem;
        align-items: baseline;
        padding: 0.85rem 1rem;
        border: 1px solid transparent;
        border-radius: 8px;
        color: #d1d5db;
        text-decoration: none;
        transition:
          background 160ms ease,
          border-color 160ms ease,
          transform 160ms ease;
      }

      .file-row:hover {
        background: rgba(8, 145, 178, 0.1);
        border-color: rgba(103, 232, 249, 0.2);
        transform: translateX(4px);
      }

      .date {
        color: #67e8f9;
        font-size: 0.86rem;
        white-space: nowrap;
      }

      .size {
        color: #94a3b8;
        font-size: 0.86rem;
      }

      .file-name {
        color: #f8fafc;
        font-weight: 800;
        line-height: 1.5;
      }

      .file-row:hover .file-name {
        color: #86efac;
      }

      .total {
        margin-top: 1.75rem;
        color: #94a3b8;
        font-size: 0.9rem;
      }

      .prompt {
        margin-top: 2rem;
        display: flex;
        gap: 0.75rem;
        align-items: center;
        color: #86efac;
      }

      .cursor {
        width: 0.7rem;
        height: 1.1rem;
        display: inline-block;
        background: #86efac;
        box-shadow: 0 0 18px rgba(134, 239, 172, 0.55);
        animation: blink 1s steps(2, start) infinite;
      }

      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      @media (max-width: 760px) {
        main {
          padding: 1rem 0.75rem 3rem;
        }

        .terminal {
          width: 100%;
        }

        .terminal-body {
          padding: 1.5rem;
        }

        .file-row {
          grid-template-columns: 1fr;
          gap: 0.25rem;
        }

        h1 {
          font-size: clamp(2.4rem, 12vw, 3.5rem);
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <section class="terminal">
        <div class="terminal-bar">
          <div class="traffic-lights">
            <span class="red"></span>
            <span class="yellow"></span>
            <span class="green"></span>
          </div>

          <div class="terminal-title">ronnie-ai-blog:~/posts</div>

          <div class="status">indexed</div>
        </div>

        <div class="terminal-body">
          <p class="command">$ ls -lah posts/</p>

          <h1>Posts</h1>

          <p class="description">
            Field notes on AI systems, semantic search, RAG pipelines,
            autonomous agents, infrastructure, automation, and the practice of
            building useful software.
          </p>

          <div class="file-list">
            {
              posts.map((post) => {
                const fileName = `${post.data.title
                  .toLowerCase()
                  .replaceAll(":", "")
                  .replaceAll(",", "")
                  .replaceAll(" ", "-")}.md`;

                return (
                  <a class="file-row" href={`/blog/${post.id}/`}>
                    <span class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                    <span class="size">4.0K</span>
                    <span class="file-name">{fileName}</span>
                  </a>
                );
              })
            }
          </div>

          <p class="total">
            total {posts.length} file{posts.length === 1 ? "" : "s"}
          </p>

          <div class="prompt">
            <span>$</span>
            <span class="cursor"></span>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
