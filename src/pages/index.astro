---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const SITE_TITLE = "Ronnie's AI Blog";
const SITE_DESCRIPTION =
	"Thoughts, experiments, and projects at the intersection of artificial intelligence, software engineering, and automation.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main class="home">
			<section class="hero">
				<p class="eyebrow">AI · Software Engineering · Automation</p>

				<h1>Ronnie's AI Blog</h1>

				<p class="subtitle">
					Thoughts, experiments, and projects at the intersection of artificial
					intelligence, software engineering, and automation.
				</p>

				<p class="description">
					I write about building real AI systems—from RAG architectures and
					semantic search engines to autonomous workflows and developer tools.
					This is a place to document ideas, share technical discoveries, and
					explore how AI can augment human knowledge and decision-making.
				</p>

				<div class="motto">
					<span>Less hype.</span>
					<span>More building.</span>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background:
			radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 34rem),
			radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.12), transparent 32rem),
			#05070a;
		color: #e5e7eb;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.home {
		min-height: 72vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 5rem 1.5rem;
	}

	.hero {
		width: min(900px, 100%);
		padding: 4rem;
		border: 1px solid rgba(148, 163, 184, 0.18);
		border-radius: 32px;
		background: rgba(15, 23, 42, 0.72);
		box-shadow: 0 30px 100px rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(18px);
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		color: #67e8f9;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		max-width: 760px;
		color: #ffffff;
		font-size: clamp(3.2rem, 8vw, 6.6rem);
		line-height: 0.92;
		letter-spacing: -0.075em;
	}

	.subtitle {
		margin: 2rem 0 0;
		max-width: 760px;
		color: #d1d5db;
		font-size: clamp(1.25rem, 2vw, 1.65rem);
		line-height: 1.45;
	}

	.description {
		margin: 1.5rem 0 0;
		max-width: 720px;
		color: #9ca3af;
		font-size: 1.06rem;
		line-height: 1.85;
	}

	.motto {
		margin-top: 2.75rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.motto span {
		border: 1px solid rgba(103, 232, 249, 0.24);
		border-radius: 999px;
		padding: 0.75rem 1rem;
		background: rgba(8, 145, 178, 0.1);
		color: #ecfeff;
		font-size: 0.95rem;
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.home {
			padding: 3rem 1rem;
		}

		.hero {
			padding: 2rem;
			border-radius: 24px;
		}
	}
</style>
