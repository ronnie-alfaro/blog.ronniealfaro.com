---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

const SITE_TITLE = "Ronnie's AI Blog";
const SITE_DESCRIPTION =
  "Thoughts, experiments, and projects about AI systems, semantic search, RAG, agents, and automation.";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="page-shell">
      <section class="terminal-window">
        <div class="terminal-bar">
          <div class="traffic-lights">
            <span class="red"></span>
            <span class="yellow"></span>
            <span class="green"></span>
          </div>

          <span class="terminal-title">ronnie-ai-blog:~</span>
          <span class="terminal-status">online</span>
        </div>

        <div class="terminal-body">
          <p class="command">$ cat README.md</p>

          <h1>Ronnie's AI Blog</h1>

          <p class="subtitle">
            Thoughts, experiments, and projects at the intersection of
            artificial intelligence, software engineering, and automation.
          </p>

          <div class="description">
            <p>
              I write about building and understanding real AI systems: RAG
              architectures, semantic search, local LLMs, neural networks,
              autonomous workflows, developer tools, infrastructure, and the
              engineering decisions behind systems that have to work outside a
              notebook. Most of it starts with a question, turns into an
              experiment, breaks at least one assumption, and eventually
              teaches me something worth writing about.
            </p>

            <p>
              Lately, that has included things like LifeSim, an artificial-life
              simulator built with Python and PyTorch, where autonomous humans
              and animals try to survive in a grid-based world by finding food,
              water, and rest. Each agent has its own neural network, spatial
              memory, and exploration profile, while also being able to learn
              from the collective experience of its species through a shared
              replay system inspired by Horde. The whole thing is observable
              through a web interface, with reproducible experiments,
              checkpoints, metrics, and training graphs that make it possible
              to watch how decisions and behaviors evolve over time.
            </p>

            <p>
              That is roughly the territory of this blog: taking AI concepts
              that are usually explained in isolation, putting them inside
              actual systems, and seeing what happens when models have memory,
              constraints, bad information, limited resources, other agents,
              and enough freedom to behave in ways I did not explicitly
              program. Sometimes the result is useful. Sometimes it is strange.
              Usually, the interesting part is figuring out why.
            </p>
          </div>

          <div class="chips">
            <span>RAG</span>
            <span>Semantic Search</span>
            <span>LLM Engineering</span>
            <span>Agents</span>
            <span>Automation</span>
            <span>Infrastructure</span>
          </div>

          <div class="boot-log">
            <p>Loading notes from the field... OK</p>
            <p>Mounting project index... OK</p>
            <p>Scanning AI experiments... OK</p>
            <p>Status: less hype, more building.</p>
          </div>

          <section class="latest-articles" aria-labelledby="latest-heading">
            <div class="latest-heading-row">
              <p class="latest-command">$ ls ./articles --latest --limit 3</p>
              <h2 id="latest-heading">Latest 3 articles</h2>
            </div>

            <div class="article-list">
              {
                latestPosts.map((post) => (
                  <a class="article-row" href={`/blog/${post.id}/`}>
                    <span class="article-date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                    <span class="article-title">{post.data.title}</span>
                    <span class="article-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                ))
              }
            </div>
          </section>

          <div class="terminal-prompt">
            <span>$</span>
            <a href="/blog">open blog</a>
            <a href="/about">about author</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background:
      linear-gradient(rgba(103, 232, 249, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(103, 232, 249, 0.035) 1px, transparent 1px),
      radial-gradient(
        circle at 20% 10%,
        rgba(34, 211, 238, 0.14),
        transparent 34rem
      ),
      radial-gradient(
        circle at 80% 90%,
        rgba(16, 185, 129, 0.1),
        transparent 34rem
      ),
      #020607;
    background-size:
      48px 48px,
      48px 48px,
      auto,
      auto,
      auto;
  }

  :global(main) {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
  }

  .page-shell {
    width: 100%;
    max-width: none;
    padding: 3rem 2rem;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }

  .terminal-window {
    width: min(1600px, 96vw);
    margin: 0 auto;
    border: 1px solid rgba(103, 232, 249, 0.25);
    border-radius: 12px;
    overflow: hidden;

    background: linear-gradient(
      180deg,
      rgba(8, 47, 55, 0.92),
      rgba(2, 16, 18, 0.96)
    );

    box-shadow:
      0 0 0 1px rgba(20, 184, 166, 0.08),
      0 30px 110px rgba(0, 0, 0, 0.55),
      0 0 80px rgba(34, 211, 238, 0.08);
  }

  .terminal-bar {
    height: 42px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 0 1rem;
    background: rgba(1, 9, 12, 0.95);
    border-bottom: 1px solid rgba(103, 232, 249, 0.2);
  }

  .traffic-lights {
    display: flex;
    gap: 0.5rem;
  }

  .traffic-lights span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
  }

  .red {
    background: #fb7185;
  }
  .yellow {
    background: #facc15;
  }
  .green {
    background: #4ade80;
  }

  .terminal-title {
    justify-self: center;
    color: #94a3b8;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: Consolas, Menlo, monospace;
  }

  .terminal-status {
    justify-self: end;
    color: #86efac;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .terminal-body {
    padding: 4rem;
  }

  .command {
    color: #86efac;
    font-family: Consolas, Menlo, monospace;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0;
    max-width: 1400px;

    color: #f8fafc;

    font-family: Inter, system-ui, sans-serif;

    font-size: clamp(4rem, 6vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
    font-weight: 720;
  }

  .subtitle {
    margin-top: 1.5rem;
    max-width: 1100px;

    color: #67e8f9;

    font-size: 1.45rem;
    line-height: 1.7;
  }

  .description {
    margin-top: 1.5rem;
    max-width: 1200px;

    color: #cbd5e1;

    font-size: 1.05rem;
    line-height: 2;
  }

  .description p {
    margin: 0;
  }

  .description p + p {
    margin-top: 1.35rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .chips span {
    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 8px;
    padding: 0.55rem 0.8rem;
    background: rgba(8, 145, 178, 0.08);
    color: #d1fae5;
    font-size: 0.8rem;
  }

  .boot-log {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(103, 232, 249, 0.15);

    color: #94a3b8;
    font-family: Consolas, Menlo, monospace;
    line-height: 1.9;
  }

  .latest-articles {
    margin-top: 2.75rem;
    padding-top: 2.25rem;
    border-top: 1px solid rgba(103, 232, 249, 0.15);
  }

  .latest-heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 1.25rem;
  }

  .latest-command {
    margin: 0;
    color: #86efac;
    font-family: Consolas, Menlo, monospace;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .latest-articles h2 {
    margin: 0;
    color: #f8fafc;
    font-family: Inter, system-ui, sans-serif;
    font-size: clamp(1.4rem, 2vw, 2rem);
    letter-spacing: -0.025em;
  }

  .article-list {
    display: grid;
    gap: 0.5rem;
  }

  .article-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(103, 232, 249, 0.14);
    border-radius: 8px;
    background: rgba(8, 145, 178, 0.055);
    color: inherit;
    text-decoration: none;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .article-row:hover {
    transform: translateX(4px);
    border-color: rgba(103, 232, 249, 0.32);
    background: rgba(8, 145, 178, 0.14);
  }

  .article-date {
    color: #94a3b8;
    font-family: Consolas, Menlo, monospace;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .article-title {
    color: #e6fffb;
    font-weight: 700;
    line-height: 1.45;
  }

  .article-arrow {
    color: #67e8f9;
    font-family: Consolas, Menlo, monospace;
    font-size: 1.15rem;
    transition: transform 160ms ease;
  }

  .article-row:hover .article-arrow {
    transform: translateX(3px);
  }

  .terminal-prompt {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .terminal-prompt span {
    color: #86efac;
    font-family: Consolas, Menlo, monospace;
    font-weight: 700;
  }

  .terminal-prompt a {
    text-decoration: none;
    color: #67e8f9;

    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 8px;
    padding: 0.55rem 0.8rem;

    background: rgba(8, 145, 178, 0.08);
  }

  .terminal-prompt a:hover {
    background: rgba(8, 145, 178, 0.18);
  }

  @media (max-width: 900px) {
    .terminal-body {
      padding: 2rem;
    }

    h1 {
      font-size: clamp(3rem, 12vw, 5rem);
    }

    .subtitle {
      font-size: 1.15rem;
    }

    .article-row {
      grid-template-columns: 1fr auto;
      gap: 0.35rem 1rem;
    }

    .article-date {
      grid-column: 1 / -1;
    }

    .article-title {
      grid-column: 1;
    }

    .article-arrow {
      grid-column: 2;
    }
  }
</style>
