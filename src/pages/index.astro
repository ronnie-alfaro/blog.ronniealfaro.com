---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const SITE_TITLE = "Ronnie's AI Blog";
const SITE_DESCRIPTION =
	"Building AI systems, semantic search engines, RAG pipelines, developer tools, and intelligent automation.";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main class="home">
			<section class="hero">
				<p class="eyebrow">
					AI • SOFTWARE ENGINEERING • AUTOMATION
				</p>

				<h1>Ronnie's AI Blog</h1>

				<p class="subtitle">
					Building AI systems, semantic search engines, RAG pipelines,
					developer tools, and intelligent automation.
				</p>

				<p class="description">
					I write about real-world AI engineering: retrieval-augmented generation,
					vector search, embeddings, agent workflows, developer tooling,
					infrastructure, and the lessons learned from building production systems.
					This blog serves as both a technical notebook and a public record of
					experiments, projects, and discoveries along the way.
				</p>

				<div class="motto">
					<span>Less hype.</span>
					<span>More building.</span>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		background:
			radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 34rem),
			radial-gradient(circle at bottom right, rgba(16, 185, 129, 0.12), transparent 32rem),
			#05070a;
		color: #e5e7eb;
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	.home {
		min-height: 72vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 5rem 2rem;
	}

	.hero {
		width: min(1200px, 100%);
		padding: 4rem;
		border: 1px solid rgba(148, 163, 184, 0.12);
		border-radius: 28px;
		background: rgba(15, 23, 42, 0.55);
		box-shadow: 0 30px 100px rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(18px);
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: #67e8f9;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		max-width: 1000px;
		color: #ffffff;
		font-size: clamp(3rem, 5vw, 4.8rem);
		line-height: 1;
		letter-spacing: -0.05em;
		font-weight: 800;
	}

	.subtitle {
		margin-top: 1.5rem;
		max-width: 950px;
		color: #d1d5db;
		font-size: clamp(1.2rem, 2vw, 1.55rem);
		line-height: 1.55;
		font-weight: 500;
	}

	.description {
		margin-top: 1.75rem;
		max-width: 950px;
		color: #9ca3af;
		font-size: 1.08rem;
		line-height: 1.9;
	}

	.motto {
		margin-top: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.motto span {
		border: 1px solid rgba(103, 232, 249, 0.2);
		border-radius: 999px;
		padding: 0.8rem 1.2rem;
		background: rgba(8, 145, 178, 0.08);
		color: #ecfeff;
		font-size: 0.95rem;
		font-weight: 700;
	}

	@media (max-width: 768px) {
		.home {
			padding: 2rem 1rem;
		}

		.hero {
			padding: 2rem;
		}

		h1 {
			font-size: clamp(2.5rem, 10vw, 3.8rem);
		}
	}
</style>
