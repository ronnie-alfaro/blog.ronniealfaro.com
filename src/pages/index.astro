---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const SITE_TITLE = "Ronnie's AI Blog";
const SITE_DESCRIPTION =
  "Thoughts, experiments, and projects about AI systems, RAG, semantic search, agents, automation, and engineering leadership.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main class="page-shell">
      <section class="terminal-window">
        <div class="terminal-bar">
          <div class="traffic-lights">
            <span class="red"></span>
            <span class="yellow"></span>
            <span class="green"></span>
          </div>

          <span class="terminal-title">ronnie-ai-blog:~</span>
          <span class="terminal-status">online</span>
        </div>

        <div class="terminal-body">
          <p class="command">$ cat README.md</p>

          <h1>Ronnie's AI Blog</h1>

          <p class="subtitle">
            Thoughts, experiments, and projects at the intersection of
            artificial intelligence, software engineering, and automation.
          </p>

          <p class="description">
            I write about building real AI systems: RAG architectures, semantic
            search engines, autonomous workflows, developer tools,
            infrastructure, and the engineering decisions behind
            production-ready AI.
          </p>

          <div class="chips">
            <span>RAG</span>
            <span>Semantic Search</span>
            <span>LLM Engineering</span>
            <span>Agents</span>
            <span>Automation</span>
            <span>Infrastructure</span>
          </div>

          <div class="boot-log">
            <p>Loading notes from the field... OK</p>
            <p>Mounting project index... OK</p>
            <p>Scanning AI experiments... OK</p>
            <p>Status: less hype, more building.</p>
          </div>

          <div class="terminal-prompt">
            <span>$</span>
            <a href="/blog">open blog</a>
            <a href="/about">about author</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background:
      linear-gradient(rgba(103, 232, 249, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(103, 232, 249, 0.035) 1px, transparent 1px),
      radial-gradient(
        circle at 20% 10%,
        rgba(34, 211, 238, 0.14),
        transparent 32rem
      ),
      radial-gradient(
        circle at 80% 90%,
        rgba(16, 185, 129, 0.1),
        transparent 32rem
      ),
      #020607;
    background-size:
      48px 48px,
      48px 48px,
      auto,
      auto,
      auto;
    color: #d1fae5;
    font-family:
      "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }

  .page-shell {
    min-height: 78vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem 4rem;
  }

  .terminal-window {
    width: min(1100px, 100%);
    border: 1px solid rgba(103, 232, 249, 0.28);
    border-radius: 12px;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(8, 47, 55, 0.92), rgba(2, 16, 18, 0.94)),
      rgba(2, 16, 18, 0.96);
    box-shadow:
      0 0 0 1px rgba(20, 184, 166, 0.08),
      0 30px 110px rgba(0, 0, 0, 0.55),
      0 0 80px rgba(34, 211, 238, 0.08);
  }

  .terminal-bar {
    height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 1rem;
    border-bottom: 1px solid rgba(103, 232, 249, 0.22);
    background: rgba(1, 9, 12, 0.92);
  }

  .traffic-lights {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .traffic-lights span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    display: block;
  }

  .red {
    background: #fb7185;
  }

  .yellow {
    background: #facc15;
  }

  .green {
    background: #4ade80;
  }

  .terminal-title {
    color: #94a3b8;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .terminal-status {
    justify-self: end;
    color: #86efac;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .terminal-body {
    padding: clamp(2rem, 5vw, 4.2rem);
  }

  .command {
    margin: 0 0 1.5rem;
    color: #86efac;
    font-size: 0.9rem;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    max-width: 980px;
    color: #f8fafc;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.075em;
    font-weight: 900;
  }

  .subtitle {
    margin: 1.2rem 0 0;
    max-width: 850px;
    color: #67e8f9;
    font-size: clamp(1rem, 2vw, 1.28rem);
    line-height: 1.55;
  }

  .description {
    margin: 1.5rem 0 0;
    max-width: 850px;
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.85;
  }

  .chips {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .chips span {
    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 7px;
    padding: 0.5rem 0.7rem;
    background: rgba(8, 145, 178, 0.08);
    color: #ccfbf1;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .boot-log {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(103, 232, 249, 0.16);
    color: #94a3b8;
    font-size: 0.86rem;
    line-height: 1.8;
  }

  .boot-log p {
    margin: 0.25rem 0;
  }

  .terminal-prompt {
    margin-top: 1.7rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    color: #86efac;
  }

  .terminal-prompt a {
    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 7px;
    padding: 0.48rem 0.7rem;
    background: rgba(8, 145, 178, 0.08);
    color: #67e8f9;
    font-size: 0.8rem;
    font-weight: 800;
    text-decoration: none;
  }

  .terminal-prompt a:hover {
    background: rgba(8, 145, 178, 0.18);
    color: #ecfeff;
  }

  @media (max-width: 720px) {
    .page-shell {
      align-items: flex-start;
      padding-top: 1.5rem;
    }

    .terminal-body {
      padding: 1.5rem;
    }

    h1 {
      font-size: clamp(2.7rem, 14vw, 4rem);
    }

    .terminal-bar {
      grid-template-columns: auto 1fr auto;
    }

    .terminal-title {
      justify-self: center;
    }
  }
</style>
