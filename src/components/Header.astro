---
const navItems = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/about', label: 'About' },
];
---

<header class="site-header">
	<a class="brand" href="/">
		<span class="brand-mark">AI</span>
		<span>Ronnie's AI Blog</span>
	</a>

	<nav>
		{navItems.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		padding: 1.1rem 2rem;
		border-bottom: 1px solid rgba(148, 163, 184, 0.12);
		background: rgba(5, 7, 10, 0.82);
		backdrop-filter: blur(18px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: #f8fafc;
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.brand-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid rgba(103, 232, 249, 0.28);
		border-radius: 0.75rem;
		background: rgba(8, 145, 178, 0.12);
		color: #67e8f9;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.08em;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	nav a {
		color: #94a3b8;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	nav a:hover {
		color: #67e8f9;
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.site-header {
			padding: 1rem;
			gap: 1rem;
		}

		.brand span:last-child {
			display: none;
		}

		nav {
			gap: 0.9rem;
		}
	}
</style>
